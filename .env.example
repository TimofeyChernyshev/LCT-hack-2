# Postgres
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_MULTIPLE_DATABASES=auth_db,dict_db,candidate_db,employer_db,testing_db,interaction_db,search_db

# Общие настройки приложения
APP_ENV=development
LOG_LEVEL=info
RUN_MIGRATIONS=true
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth
AUTH_DB_NAME=auth_db
AUTH_SHUTDOWN_TIMEOUT=30s
JWT_SECRET=dev-secret-change-me-please-32-chars-min
JWT_ISSUER=fsp-platform
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
AUTH_RATE_LIMITER_RPS=20
AUTH_RATE_LIMITER_BURST=40

# SMTP (MailHog по умолчанию)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fsp.local
SMTP_TLS=false
SMTP_MODE=none # none | starttls | implicit

# Dict
DICT_DB_NAME=dict_db
DICT_SHUTDOWN_TIMEOUT=30s
DICT_CACHE_TTL=10m

# Candidate
CANDIDATE_DB_NAME=candidate_db
CANDIDATE_SHUTDOWN_TIMEOUT=30s
CANDIDATE_UPLOAD_DIR=/var/lib/fsp/uploads
CANDIDATE_MAX_UPLOAD_BYTES=10485760
CANDIDATE_HTTP_TIMEOUT=5s
CANDIDATE_HTTP_RETRIES=3

# Employer
EMPLOYER_DB_NAME=employer_db
EMPLOYER_SHUTDOWN_TIMEOUT=30s
EMPLOYER_HTTP_TIMEOUT=5s
EMPLOYER_HTTP_RETRIES=3

# Testing
TESTING_DB_NAME=testing_db
TESTING_SHUTDOWN_TIMEOUT=30s
GRADE_CHANGE_COOLDOWN_DAYS=90
TESTING_ITEMS_PER_SESSION=20
TESTING_PASS_THRESHOLD_RATIO=0.7
TESTING_UPGRADE_THRESHOLD_RATIO=0.9
TESTING_HTTP_TIMEOUT=5s
TESTING_HTTP_RETRIES=3

# Interaction
INTERACTION_DB_NAME=interaction_db
INTERACTION_SHUTDOWN_TIMEOUT=30s
REVEAL_CONTACTS_ON_APPLICATION=true
INTERACTION_HTTP_TIMEOUT=5s
INTERACTION_HTTP_RETRIES=3

# Search
SEARCH_DB_NAME=search_db
SEARCH_SHUTDOWN_TIMEOUT=30s
SEARCH_SYNC_BATCH_SIZE=100
SEARCH_SYNC_INTERVAL=30s
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
SEARCH_HTTP_TIMEOUT=5s

# Межсервисные адреса (внутри docker-сети)
AUTH_SERVICE_URL=http://auth:8080
DICT_SERVICE_URL=http://dict:8080
CANDIDATE_SERVICE_URL=http://candidate:8080
EMPLOYER_SERVICE_URL=http://employer:8080
TESTING_SERVICE_URL=http://testing:8080
INTERACTION_SERVICE_URL=http://interaction:8080
SEARCH_SERVICE_URL=http://search:8080

# Хостовые порты
AUTH_HOST_PORT=8081
DICT_HOST_PORT=8082
CANDIDATE_HOST_PORT=8083
EMPLOYER_HOST_PORT=8084
TESTING_HOST_PORT=8085
INTERACTION_HOST_PORT=8086
SEARCH_HOST_PORT=8087
FRONTEND_HOST_PORT=3000
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025
POSTGRES_HOST_PORT=5432

# nginx
GATEWAY_HOST_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api

# swagger
SWAGGER_HOST_PORT=8090
SWAGGER_SPEC_AUTH=/specs/auth.yaml
SWAGGER_SPEC_DICT=/specs/dict.yaml
SWAGGER_SPEC_CANDIDATE=/specs/candidate.yaml
SWAGGER_SPEC_EMPLOYER=/specs/employer.yaml
SWAGGER_SPEC_TESTING=/specs/testing.yaml
SWAGGER_SPEC_INTERACTION=/specs/interaction.yaml
SWAGGER_SPEC_SEARCH=/specs/search.yaml